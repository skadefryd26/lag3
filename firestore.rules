rules_version = '2';

// Poengtavla: alle kan lese og legge til, ingen kan endre eller slette.
// Reglene sjekker formen på det som skrives, så lista ikke fylles med søppel.
service cloud.firestore {
  match /databases/{database}/documents {
    match /highscores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['navn', 'poeng', 'grad', 'uke', 'dato'])
        && request.resource.data.keys().hasAll(['navn', 'poeng', 'grad', 'uke', 'dato'])
        && request.resource.data.navn is string
        && request.resource.data.navn.size() > 0
        && request.resource.data.navn.size() <= 24
        && request.resource.data.poeng is int
        && request.resource.data.poeng > 0
        && request.resource.data.poeng <= 100000
        && request.resource.data.grad in ['vikar', 'fulltid', 'senior']
        && request.resource.data.uke is string
        && request.resource.data.uke.matches('^[0-9]{4}-U[0-9]{2}$')
        && request.resource.data.dato == request.time;
      allow update, delete: if false;
    }
  }
}
